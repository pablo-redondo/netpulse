# En local basta con una sola cadena: un Postgres de desarrollo no tiene
# pooler delante, y DIRECT_URL se puede dejar sin definir (prisma.config.ts
# cae a DATABASE_URL).
DATABASE_URL="postgresql://netpulse:netpulse@localhost:5432/netpulse?schema=public"
PORT=3001
CHECK_INTERVAL_MS=300000

# En produccion (Neon) van las dos, y no son intercambiables:
#   DATABASE_URL -> cadena CON pooler (el host lleva "-pooler"), la que usa
#                   la app en marcha.
#   DIRECT_URL   -> cadena SIN pooler, solo para `prisma migrate deploy`: por
#                   el pooler las migraciones fallan. Ver prisma.config.ts.
# Ambas terminan en ?sslmode=require.
# DIRECT_URL=

# Opcionales: ver README.md > Variables de entorno
# ALERT_WEBHOOK_URL=
# SEED_SECRET=
